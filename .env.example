# Get a key at https://tokenfactory.nebius.com/
# Free credits: promo form + activation code NEBIUS-DEVPOST-GLOBAL26
NEBIUS_API_KEY=

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Larger model for the main answer call.
NEBIUS_MAIN_MODEL=nvidia/nemotron-3-super-120b-a12b

# Smaller model for the background extraction call.
NEBIUS_EXTRACTION_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Swappable depending on target device. Must be the full fastembed id: the bare
# "paraphrase-multilingual-MiniLM-L12-v2" is rejected by fastembed as unsupported.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DIM=384
# Where the ONNX files live (default: ./models). Populated once by
# scripts/fetch_embedding_model.py; the embedder never downloads at runtime.
# LOCAL_EMBEDDING_CACHE_DIR=./models

# Per-device state: DLL JSON (L2), LanceDB (L3), embedding stamp (default: ./data).
# APU_DATA_DIR=./data

# Cap on non-fixed DLL blocks (Akili value). Past it, LRU page-out to L3.
APU_MAX_DYNAMIC_BLOCKS=5

# Not wired yet: the 12-block cap from the travel-agent APU, see HACKATHON.md.
APU_MAX_ACTIVE_BLOCKS=12

# ── Cloud course registry (Google Cloud Storage) ────────────────────────────
# Device: registry to download courses from. The bucket is read from this URL.
# REGISTRY_MANIFEST_URL=https://storage.googleapis.com/akili-registry/manifest.json
# Pipeline: bucket that `batch_pipeline.py --upload` publishes to.
# GCS_BUCKET_NAME=akili-registry
# Both: service-account JSON. Leave unset to use Application Default Credentials
# (gcloud auth application-default login). Downloading needs one or the other.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Web search (Tavily) ──────────────────────────────────────────────────────
# Tavily credits are included in the Nebius x NVIDIA hackathon promo bundle: redeem
# them from the bundle, then paste the Tavily API key here.
TAVILY_API_KEY=

# ── Registries loaded at startup (demo data in registries/) ─────────────────
# APU_CLASS_POLICIES_PATH=registries/class_policies.json
# APU_TEACHER_ASSIGNMENTS_PATH=registries/teacher_assignments.json
# Recompute a class's escalation clusters after this many new events.
# APU_ESCALATION_CLUSTER_TRIGGER_COUNT=5

# ── Dashboard identity: STUB, there is no login ─────────────────────────────
# APU_STUDENT_ID=eleve-demo
# APU_CLASS_ID=lycee-cocody:3eA

# ── Braille ──────────────────────────────────────────────────────────────────
# Needs the liblouis C library (brew install liblouis / apt install liblouis20).
# Only set this if the library is somewhere non-standard.
# LIBLOUIS_PATH=
